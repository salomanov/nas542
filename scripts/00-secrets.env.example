# Скопируйте в 00-secrets.env и заполните.
# Файл 00-secrets.env в .gitignore и в репозиторий не попадает.
#
# Пароли: только буквы, цифры, дефис и подчёркивание.
# Символы & | \ " ломают подстановку в конфиги.

# --- доступ к NAS ---
NAS_LAN_IP=192.168.1.50
NAS_WAN_IP=CHANGE_ME
NAS_ADMIN_USER=admin
NAS_ADMIN_PASS=CHANGE_ME
SSH_PORT=34522

# --- FileBrowser (порт 5007) ---
FB_USER=admin
FB_PASS=CHANGE_ME

# --- Transmission (порт 5008) ---
TR_USER=admin
TR_PASS=CHANGE_ME

# --- aria2 RPC (порт 6800) ---
ARIA2_SECRET=CHANGE_ME

# --- Syncthing GUI (порт 5004) ---
ST_USER=admin
ST_PASS=CHANGE_ME

# --- COPS / OPDS (порт 5005) ---
COPS_USER=admin
COPS_PASS=CHANGE_ME
