# Shell scripts and configs must stay LF: they are executed by Linux on the NAS.
* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
*.json  text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.block text eol=lf
*.crt   text eol=lf
*.md    text eol=lf

# Binary assets
*.ico   binary
*.png   binary

# Windows helpers
*.ps1   text eol=crlf
*.cmd   text eol=crlf
